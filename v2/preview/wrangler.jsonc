{
  "name": "leapsign-v2-ui-preview",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "pruebas.leapsign.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": { "enabled": false },
  "vars": {
    "V2_ORIGIN": "https://pruebas.leapsign.app",
    "SUPABASE_V2_URL": "https://lbreydchhskrrmpzniem.supabase.co",
    "V2_STORAGE_BUCKET": "v2-pdfs",
    "V2_DIRECT_ENABLED": "false",
    "V2_EXTERNAL_ENABLED": "false",
    "V2_PROFILE_ENABLED": "false"
  }
}
